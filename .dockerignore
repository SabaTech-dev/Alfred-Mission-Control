# =============================================================================
# .dockerignore — keep build context lean and secrets out of the image
# =============================================================================
# Rationale: without this, `COPY . .` ships a 1.2 GB local node_modules that
# collides with the one created by `npm install` (overlayfs "cannot replace to
# directory" error) and bakes .env.local secrets into the image.

# --- Version control ---
.git
.gitignore
.gitattributes

# --- Dependencies (regenerated inside the image) ---
node_modules

# --- Non-npm lockfiles ---
# The image builds with npm (package-lock.json). Leaving pnpm-lock.yaml /
# yarn.lock in the context makes Next.js 16 misdetect the package manager and
# try to `pnpm add` missing deps at build time (pnpm is not in the image).
pnpm-lock.yaml
yarn.lock

# --- Build output (regenerated by `npm run build`) ---
.next
out

# --- Secrets — NEVER bake into images ---
.env
.env.*
!.env.example

# --- Docker files (not needed inside the image) ---
Dockerfile*
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# --- Logs & debug artifacts ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# --- Test artifacts (not needed to run the app) ---
coverage
playwright-report
test-results
.nyc_output

# --- IDE / editor ---
.vscode
.idea
*.swp

# --- Backups ---
*.bak
*.bak2
