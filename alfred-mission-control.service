[Unit]
Description=Alfred Mission Control (Next.js)
After=network.target openclaw-gateway.service
Wants=openclaw-gateway.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/.openclaw/workspace/mission-control-superbotijo
ExecStart=/usr/bin/node node_modules/.bin/next start -p 3000
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
Environment=OPENCLAW_DIR=/home/ubuntu/.openclaw
Environment=OPENCLAW_WORKSPACE=/home/ubuntu/.openclaw/workspace

[Install]
WantedBy=default.target
